# Copy to ".env" (same folder as config.py) and adjust. ".env" is git-ignored.
# Every path is optional; the defaults keep everything inside this folder.

# SQLite databases, raw API caches, calibration CSVs
DATA_DIR=./data
# Where team_report.html / track_record.html are written
OUTPUT_DIR=./output
# A separate git checkout served by GitHub Pages (update_fotmob.py copies the report there)
PUBLISH_DIR=./publish
# Optional: legacy Markdown match clippings (only parse_sofa.py / early_payout.py use it)
VAULT_ROOT=./vault
# Optional: football-data.co.uk CSV dumps (only h2h.py uses it)
FOOTBALL_DATA_RAW_DIR=./data/football_data_raw

# Optional: Telegram alert with the top picks (top_picks_alert.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
